// Config de rmpc. Solo lleva lo que se aparta del default; el resto (incluidos
// los keybinds, que ya son estilo vim) se toma de fábrica. Para ver el default
// completo y de dónde salen estos nombres: `rmpc config`.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    // MPD escucha solo en loopback (ver programs/mpd.nix). El servicio también
    // exporta MPD_HOST/MPD_PORT, así que esto es redundante a propósito: rmpc
    // sigue funcionando aunque lo lances desde un entorno sin esas variables.
    address: "127.0.0.1:6600",
    theme: "catppuccin-mocha",
    // Letras. rmpc NO lee el tag LYRICS embebido en los FLAC: busca un .lrc
    // aquí, espejando la ruta relativa del archivo dentro de ~/Music. Los
    // genera `rmpc-sync-lyrics` (ver programs/mpd.nix).
    lyrics_dir: "~/.local/share/rmpc/lyrics",
    volume_step: 5,
    // La biblioteca es chica; que el cursor no se pegue a los bordes.
    scrolloff: 4,
    wrap_navigation: true,
    album_art: (
        // Auto detecta el protocolo gráfico del terminal. Ghostty implementa el
        // de Kitty, así que la carátula sale como imagen de verdad, no en ASCII.
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),

    // Visualizador. rmpc lanza cava por dentro y le pasa esto tal cual, por eso
    // los nombres son los de cava y no los de rmpc. La entrada tiene que
    // coincidir con el audio_output "fifo" de programs/mpd.nix: mismo path y
    // mismo formato 44100:16:2, si no, no dibuja nada.
    // Los colores NO van aquí, van en el tema (themes/catppuccin-mocha.ron).
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 100,
        // Recorta los extremos que no aportan nada visual: por debajo de 50 Hz
        // casi no hay energía en esta música y arriba de 10 kHz son platillos.
        lower_cutoff_freq: 50,
        higher_cutoff_freq: 10000,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 65,
            // Suaviza entre barras vecinas: el espectro se mueve como una onda
            // continua en vez de columnas sueltas brincando.
            monstercat: true,
            waves: false,
        ),
    ),

    // OJO: declarar `tabs` reemplaza la lista completa, no la extiende. Por eso
    // están aquí las siete pestañas y no solo la que se modificó. Salió de
    // `rmpc config`; el único cambio respecto al default es el panel Cava
    // dentro de "Queue", entre la carátula y las letras.
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "35%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "100%",
                                    borders: "LEFT | RIGHT | TOP",
                                    border_symbols: Rounded,
                                    pane: Pane(AlbumArt)
                                ),
                                (
                                    size: "9",
                                    borders: "ALL",
                                    border_symbols: Inherited(parent: Rounded, top_left: "├", top_right: "┤",),
                                    pane: Pane(Cava)
                                ),
                                (
                                    size: "7",
                                    borders: "ALL",
                                    border_symbols: Inherited(parent: Rounded, top_left: "├", top_right: "┤",),
                                    border_title: [(kind: Text(" Lyrics "))],
                                    border_title_alignment: Right,
                                    pane: Pane(Lyrics)
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "65%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "3",
                                    borders: "ALL",
                                    border_symbols: Inherited(parent: Rounded, bottom_left: "├", bottom_right: "┤",),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (size: "1", pane: Pane(Empty())),
                                            (size: "100%", pane: Pane(QueueHeader())),
                                        ]
                                    )
                                ),
                                (
                                    size: "100%",
                                    borders: "LEFT | RIGHT | BOTTOM",
                                    border_symbols: Rounded,
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (size: "1", pane: Pane(Empty())),
                                            (size: "100%", pane: Pane(Queue)),
                                        ]
                                    )
                                ),
                            ],
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Directories",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Directories), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Artists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Artists), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Album Artists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(AlbumArtists), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Albums",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Albums), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Playlists",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Playlists), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
        (
            name: "Search",
            borders: "ALL",
            border_symbols: Rounded,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Search), size: "100%", borders: "ALL", border_symbols: Rounded)],
            )
        ),
    ],
)
