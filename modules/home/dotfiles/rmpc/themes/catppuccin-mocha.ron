// Catppuccin Mocha para rmpc, igual que Ghostty, nvim y DMS.
//
// Generado con `rmpc theme` (el tema por defecto de la versión instalada) y
// sustituyendo los colores nombrados por la paleta. Al actualizar rmpc, si
// cambia el esquema, se regenera igual: `rmpc theme > base.ron` y se vuelven
// a aplicar los colores. Estructura y layout son los de fábrica.
//
// Los colores están repartidos por ROL, no al gusto. Si todo lleva el mauve
// del sistema la pantalla se vuelve un bloque rosa y no se distingue nada;
// cada acento significa una cosa:
//
//   peach    #fab387  lo que suena: pestaña activa, barra de progreso, artista
//   mauve    #cba6f7  navegación y foco: borde del panel activo, coincidencias
//                     de búsqueda, modo NORMAL
//   blue     #89b4fa  volumen y scrollbar (controles, no contenido)
//   lavender #b4befe  álbum
//   green    #a6e3a1  estado de reproducción y modo INSERT
//   yellow   #f9e2af  banderas activas (repeat/random/consume/single) y
//                     etiquetas de metadatos
//   grises   surface/overlay: fila del cursor, texto secundario, bordes
//
// Al agregar algo nuevo conviene meterlo en un rol existente antes que sacar
// un color más de la paleta.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "#cdd6f4",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    preview_label_style: (fg: "#f9e2af"),
    preview_metadata_group_style: (fg: "#f9e2af", modifiers: "Bold"),
    // Coincidencias de búsqueda y elementos marcados: aquí sí el mauve, que es
    // justo donde quieres que el ojo salte.
    highlighted_item_style: (fg: "#cba6f7", modifiers: "Bold"),
    // La fila del cursor en gris (surface1), no en un bloque mauve sólido. Es
    // lo que más se repite en pantalla —hay una en cada panel— y en mauve se
    // comía todo lo demás.
    current_item_style: (fg: "#cdd6f4", bg: "#45475a", modifiers: "Bold"),
    borders_style: (fg: "#585b70"),
    highlight_border_style: (fg: "#cba6f7"),
    symbols: (
        song: "󰝚 ",
        dir: "󰉋 ",
        playlist: "󰲹 ",
        marker: "󰐊 ",
        ellipsis: "...",
        // Los iconos con color propio dan a los navegadores algo de relieve sin
        // teñir el texto: la canción neutra, la carpeta azul, la playlist teal.
        song_style: (fg: "#6c7086"),
        dir_style: (fg: "#89b4fa"),
        playlist_style: (fg: "#94e2d5"),
    ),
    level_styles: (
        info: (fg: "#89b4fa", bg: "#1e1e2e"),
        warn: (fg: "#f9e2af", bg: "#1e1e2e"),
        error: (fg: "#f38ba8", bg: "#1e1e2e"),
        debug: (fg: "#a6e3a1", bg: "#1e1e2e"),
        trace: (fg: "#6c7086", bg: "#1e1e2e"),
    ),
    // Las 5 ranuras son [inicio, reproducido, thumb, track, fin]; comprobado
    // renderizando con un glifo distinto en cada una. El "fin" no se dibuja
    // nunca (ni al 99%), por eso no se puede rematar la barra con una tapa
    // redonda: quedaría curva de un lado y cuadrada del otro.
    //
    // ▄ (medio bloque inferior) en vez de █: la barra conserva su carácter de
    // barra pero con la mitad de peso visual, que era el problema —peach macizo
    // de ancho completo dominaba la pantalla. El thumb sí va en █ para que la
    // posición actual sobresalga contra el resto.
    //
    // El track antes era " ", así que track_style no pintaba nada y la barra se
    // leía como una losa naranja flotando en el vacío. Con ▄ en surface0 se ve
    // el recorrido completo.
    progress_bar: (
        symbols: ["▄", "▄", "█", "▄", "▄"],
        track_style: (fg: "#313244"),
        elapsed_style: (fg: "#fab387"),
        thumb_style: (fg: "#f9e2af"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#313244"),
        ends_style: (fg: "#45475a"),
        thumb_style: (fg: "#89b4fa"),
    ),
    tab_bar: (
        active_style: (fg: "#1e1e2e", bg: "#fab387", modifiers: "Bold"),
        inactive_style: (fg: "#9399b2"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "22%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "45%",
        ),
        (
            // Atenuado a propósito: en una cola de un mismo disco el álbum se
            // repite en todas las filas y compite con el título. En gris se
            // lee igual pero deja de gritar.
            prop: (kind: Property(Album), style: (fg: "#7f849c"),
                default: (kind: Text("Unknown Album"), style: (fg: "#6c7086"))
            ),
            label_prop: (kind: Text("Album")),
            width: "25%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            // 8%: "3:28" son cuatro caracteres, con 15% sobraba media pantalla.
            // Lo liberado se fue al título, que era el que se truncaba.
            width: "8%",
            alignment: Right,
        ),
    ],
    // Estructura general: navegación arriba, contenido en medio, estado abajo.
    // Es el mismo modelo que tu nvim (bufferline arriba, lualine abajo) y la
    // convención de las TUI en general (vim, tmux, cmus, ncmpcpp).
    //
    // El default de rmpc parte el transporte en dos: título y volumen arriba,
    // barra de progreso abajo. Son el mismo grupo funcional —qué suena y por
    // dónde va— así que aquí van juntos en un solo pie.
    //
    // De paso sale algo más barato: antes eran 9 filas de marco (4 cabecera + 2
    // pestañas + 3 barra) y ahora son 8 (3 + 5), o sea una fila más de
    // contenido. Las pestañas suben a 3 porque ahora necesitan su propio borde
    // superior, que antes se lo prestaba la caja de la cabecera.
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Pane(Tabs),
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            // Pie unificado. Una sola caja, no dos apiladas: con marco propio
            // cada una el pie subía a 7 filas y la interfaz quedaba pesada abajo.
            //
            //   fila 1-2  estado/tiempo │ título/artista │ volumen/banderas
            //   fila 3    modo + barra de progreso
            //
            // La barra debajo del texto y no encima: se lee "qué suena -> por
            // dónde va", y su base cae en la última fila de la app, alineada con
            // el borde inferior de todo lo demás.
            (
                size: "5",
                borders: "ALL",
                border_symbols: Rounded,
                border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                border_title_alignment: Right,
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (
                            size: "2",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    // Separadores simples entre las tres zonas:
                                    // solo la línea vertical, sin esquinas, para
                                    // no volver a meter cajas dentro de cajas.
                                    (
                                        size: "35",
                                        borders: "RIGHT",
                                        border_symbols: Rounded,
                                        pane: Component("header_left")
                                    ),
                                    (
                                        size: "100%",
                                        pane: Component("header_center")
                                    ),
                                    (
                                        size: "35",
                                        borders: "LEFT",
                                        border_symbols: Rounded,
                                        pane: Component("header_right")
                                    ),
                                ]
                            )
                        ),
                        (
                            size: "1",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    // El chip de modo ya lleva fondo propio, así
                                    // que no necesita marco para leerse como chip.
                                    (size: "10", pane: Component("input_mode")),
                                    (size: "100%", pane: Component("progress_bar")),
                                ]
                            )
                        ),
                    ]
                )
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#6c7086")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#a6e3a1", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#6c7086")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#89b4fa"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#6c7086"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#cdd6f4")),
                (kind: Text(" / "), style: (fg: "#6c7086")),
                (kind: Property(Status(Duration)), style: (fg: "#a6adc8")),
                // El bitrate es dato de fondo, no titular.
                (kind: Group([
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ]), style: (fg: "#6c7086")),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#fab387", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#6c7086", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "#6c7086")),
                (kind: Property(Song(Album)), style: (fg: "#b4befe"),
                    default: (kind: Text("Unknown Album"), style: (fg: "#6c7086"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#cba6f7"), align: Left)]))
                ),
                (
                    size: "6",
                    // Banderas de reproducción: apagadas en gris, encendidas en
                    // amarillo. Antes las apagadas eran mauve atenuado y se
                    // veían tan "activas" como las encendidas.
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#6c7086")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#f9e2af", modifiers: "Bold"),
                            off_style: (fg: "#45475a"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#f9e2af", modifiers: "Bold"),
                            off_style: (fg: "#45475a"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#f9e2af", modifiers: "Bold"),
                            off_style: (fg: "#45475a"),
                            oneshot_style: (fg: "#f38ba8", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#f9e2af", modifiers: "Bold"),
                            off_style: (fg: "#45475a"),
                            oneshot_style: (fg: "#f38ba8", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#6c7086")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#1e1e2e", bg: "#cba6f7"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#1e1e2e", bg: "#a6e3a1"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },

    // Visualizador. El comportamiento (entrada FIFO, suavizado, cortes de
    // frecuencia) va en config.ron; aquí solo el aspecto.
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        inverted_bar_as_mask: false,
        bar_width: 1,
        bar_spacing: 1,
        orientation: Bottom,
        // Mismo degradado que el cava suelto (programs/cava.nix): recorrido del
        // círculo de tono con el mauve del sistema en el centro. Las claves son
        // el porcentaje de altura donde arranca cada color; entre una y otra
        // rmpc interpola.
        bar_color: Gradient({
              0: "#94e2d5",
             14: "#89b4fa",
             28: "#b4befe",
             43: "#cba6f7",
             57: "#f5c2e7",
             71: "#eba0ac",
             85: "#fab387",
            100: "#f9e2af",
        }),
    ),
)
