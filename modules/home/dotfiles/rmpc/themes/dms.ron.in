// Plantilla del tema RMPC. DMS asigna el primario a navegación y foco, el
// terciario a la reproducción y los tonos de superficie a la fila del cursor.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "@on_surface@",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    preview_label_style: (fg: "@yellow@"),
    preview_metadata_group_style: (fg: "@yellow@", modifiers: "Bold"),
    highlighted_item_style: (fg: "@primary@", modifiers: "Bold"),
    current_item_style: (fg: "@on_surface@", bg: "@surface_container_highest@", modifiers: "Bold"),
    borders_style: (fg: "@outline@"),
    highlight_border_style: (fg: "@primary@"),
    symbols: (
        song: "󰝚 ",
        dir: "󰉋 ",
        playlist: "󰲹 ",
        marker: "󰐊 ",
        ellipsis: "...",
        // Los iconos con color propio dan a los navegadores algo de relieve sin
        // teñir el texto: la canción neutra, la carpeta azul, la playlist teal.
        song_style: (fg: "@on_surface_variant@"),
        dir_style: (fg: "@blue@"),
        playlist_style: (fg: "@cyan@"),
    ),
    level_styles: (
        info: (fg: "@blue@", bg: "@background@"),
        warn: (fg: "@yellow@", bg: "@background@"),
        error: (fg: "@error@", bg: "@background@"),
        debug: (fg: "@green@", bg: "@background@"),
        trace: (fg: "@on_surface_variant@", bg: "@background@"),
    ),
    // Las 5 ranuras son [inicio, reproducido, thumb, track, fin]; comprobado
    // renderizando con un glifo distinto en cada una. El "fin" no se dibuja
    // nunca (ni al 99%), por eso no se puede rematar la barra con una tapa
    // redonda: quedaría curva de un lado y cuadrada del otro.
    //
    // ▄ (medio bloque inferior) en vez de █: la barra conserva su carácter de
    // barra pero con la mitad de peso visual: una barra maciza
    // de ancho completo dominaba la pantalla. El thumb sí va en █ para que la
    // posición actual sobresalga contra el resto.
    //
    // El track antes era " ", así que track_style no pintaba nada y la barra se
    // leía como una losa de color flotando en el vacío. Con ▄ se ve
    // el recorrido completo.
    progress_bar: (
        symbols: ["▄", "▄", "█", "▄", "▄"],
        track_style: (fg: "@surface_container_high@"),
        elapsed_style: (fg: "@tertiary@"),
        thumb_style: (fg: "@yellow@"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "@surface_container_high@"),
        ends_style: (fg: "@outline@"),
        thumb_style: (fg: "@blue@"),
    ),
    tab_bar: (
        active_style: (fg: "@on_tertiary@", bg: "@tertiary@", modifiers: "Bold"),
        inactive_style: (fg: "@on_surface_variant@"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "22%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "45%",
        ),
        (
            // Atenuado a propósito: en una cola de un mismo disco el álbum se
            // repite en todas las filas y compite con el título. En gris se
            // lee igual pero deja de gritar.
            prop: (kind: Property(Album), style: (fg: "@on_surface_variant@"),
                default: (kind: Text("Unknown Album"), style: (fg: "@on_surface_variant@"))
            ),
            label_prop: (kind: Text("Album")),
            width: "25%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            // 8%: "3:28" son cuatro caracteres, con 15% sobraba media pantalla.
            // Lo liberado se fue al título, que era el que se truncaba.
            width: "8%",
            alignment: Right,
        ),
    ],
    // Estructura general: navegación arriba, contenido en medio, estado abajo.
    // Es el mismo modelo que tu nvim (bufferline arriba, lualine abajo) y la
    // convención de las TUI en general (vim, tmux, cmus, ncmpcpp).
    //
    // El default de rmpc parte el transporte en dos: título y volumen arriba,
    // barra de progreso abajo. Son el mismo grupo funcional —qué suena y por
    // dónde va— así que aquí van juntos en un solo pie.
    //
    // De paso sale algo más barato: antes eran 9 filas de marco (4 cabecera + 2
    // pestañas + 3 barra) y ahora son 8 (3 + 5), o sea una fila más de
    // contenido. Las pestañas suben a 3 porque ahora necesitan su propio borde
    // superior, que antes se lo prestaba la caja de la cabecera.
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Pane(Tabs),
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            // Pie unificado. Una sola caja, no dos apiladas: con marco propio
            // cada una el pie subía a 7 filas y la interfaz quedaba pesada abajo.
            //
            //   fila 1-2  estado/tiempo │ título/artista │ volumen/banderas
            //   fila 3    modo + barra de progreso
            //
            // La barra debajo del texto y no encima: se lee "qué suena -> por
            // dónde va", y su base cae en la última fila de la app, alineada con
            // el borde inferior de todo lo demás.
            (
                size: "5",
                borders: "ALL",
                border_symbols: Rounded,
                border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                border_title_alignment: Right,
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (
                            size: "2",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    // Separadores simples entre las tres zonas:
                                    // solo la línea vertical, sin esquinas, para
                                    // no volver a meter cajas dentro de cajas.
                                    (
                                        size: "35",
                                        borders: "RIGHT",
                                        border_symbols: Rounded,
                                        pane: Component("header_left")
                                    ),
                                    (
                                        size: "100%",
                                        pane: Component("header_center")
                                    ),
                                    (
                                        size: "35",
                                        borders: "LEFT",
                                        border_symbols: Rounded,
                                        pane: Component("header_right")
                                    ),
                                ]
                            )
                        ),
                        (
                            size: "1",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    // El chip de modo ya lleva fondo propio, así
                                    // que no necesita marco para leerse como chip.
                                    // 12, no 10: el chip creció 2 columnas al
                                    // ponerle las tapas redondas (ver el
                                    // componente "input_mode" más abajo).
                                    (size: "12", pane: Component("input_mode")),
                                    (size: "100%", pane: Component("progress_bar")),
                                ]
                            )
                        ),
                    ]
                )
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "@on_surface_variant@")),
                (kind: Property(Status(StateV2( ))), style: (fg: "@green@", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "@on_surface_variant@")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "@blue@"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "@on_surface_variant@"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "@on_surface@")),
                (kind: Text(" / "), style: (fg: "@on_surface_variant@")),
                (kind: Property(Status(Duration)), style: (fg: "@on_surface_variant@")),
                // El bitrate es dato de fondo, no titular.
                (kind: Group([
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ]), style: (fg: "@on_surface_variant@")),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "@tertiary@", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "@on_surface_variant@", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "@on_surface_variant@")),
                (kind: Property(Song(Album)), style: (fg: "@secondary@"),
                    default: (kind: Text("Unknown Album"), style: (fg: "@on_surface_variant@"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "@primary@"), align: Left)]))
                ),
                (
                    size: "6",
                    // Banderas de reproducción: apagadas en gris, encendidas en
                    // amarillo. Antes las apagadas eran mauve atenuado y se
                    // veían tan "activas" como las encendidas.
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "@on_surface_variant@")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "@yellow@", modifiers: "Bold"),
                            off_style: (fg: "@outline@"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "@yellow@", modifiers: "Bold"),
                            off_style: (fg: "@outline@"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "@yellow@", modifiers: "Bold"),
                            off_style: (fg: "@outline@"),
                            oneshot_style: (fg: "@error@", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "@yellow@", modifiers: "Bold"),
                            off_style: (fg: "@outline@"),
                            oneshot_style: (fg: "@error@", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "@on_surface_variant@")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        // El chip de modo, rematado con las mismas tapas redondas (U+E0B6 y
        // U+E0B4) que abren y cierran el prompt de starship y las pastillas de
        // la barra de estado de Yazi. Las tres TUI comparten así el mismo
        // vocabulario de forma, que es lo que hace que se lean como un solo
        // escritorio y no como tres programas sueltos.
        //
        // Las tapas llevan el color del chip en `fg` y ningún `bg`: el glifo es
        // un semicírculo relleno, así que pintado sobre el fondo de la app
        // continúa el rectángulo y lo redondea. Por eso el color se repite en
        // cada rama del Replace: cada modo tiene el suyo.
        //
        // Son tres Replace en la lista de `content` y no un Group de tres
        // trozos con estilo cada uno, aunque el Group sea más corto. Motivo:
        // rmpc ignora en silencio los campos que no conoce dentro de un Group
        // (comprobado colándole un `bogus:` inventado y arrancando igual), así
        // que no había forma de saber si respetaba el `style` de cada hijo. La
        // lista de `content` con un `style` por elemento sí está probada: es lo
        // que usa el componente "state" de aquí abajo, y el `style` dentro de
        // `replace:` es el que ya pintaba el chip antes de las tapas.
        //
        // Anchura: 1 tapa + 8 del rótulo + 1 tapa = 10, centrado en un panel de
        // 12, que deja el mismo espacio de 1 columna a cada lado que había
        // antes con el rótulo pelado en un panel de 10. Si algún día se añade
        // un modo con un rótulo de otra longitud, hay que recalcular el 12.
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(""), style: (fg: "@primary@"))),
                    (match: "Insert", replace: (kind: Text(""), style: (fg: "@green@"))),
                ]))),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "@on_primary@", bg: "@primary@"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "@background@", bg: "@green@"))),
                ]))),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(""), style: (fg: "@primary@"))),
                    (match: "Insert", replace: (kind: Text(""), style: (fg: "@green@"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },

    // Visualizador. El comportamiento (entrada FIFO, suavizado, cortes de
    // frecuencia) va en config.ron; aquí solo el aspecto.
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        inverted_bar_as_mask: false,
        bar_width: 1,
        bar_spacing: 1,
        orientation: Bottom,
        // Mismo degradado que el cava suelto (programs/cava.nix): recorrido del
        // círculo de tono con el mauve del sistema en el centro. Las claves son
        // el porcentaje de altura donde arranca cada color; entre una y otra
        // rmpc interpola.
        bar_color: Gradient({
              0: "@secondary@",
             14: "@blue@",
             28: "@cyan@",
             43: "@primary@",
             57: "@tertiary@",
             71: "@red@",
             85: "@yellow@",
            100: "@bright_yellow@",
        }),
    ),
)
