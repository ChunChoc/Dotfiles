{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Colores ANSI: siguen la paleta dinámica de DMS a través del terminal.
  "display": {
    "color": {
      "keys": "default"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "blue",
      "2": "light_blue"
    },
    "padding": {
      "left": 2,
      "top": 2
    },
    "source": "NixOS_small",
    "type": "builtin"
  },
  "modules": [
    {
      "color": {
        "at": "light_black",
        "host": "light_red",
        "user": "light_red"
      },
      "type": "title"
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": " os",
      "keyColor": "light_blue",
      "type": "os"
    },
    {
      "key": " kernel",
      "keyColor": "light_magenta",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": " wm",
      "keyColor": "light_red",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": " shell",
      "keyColor": "light_green",
      "type": "shell"
    },
    {
      "format": "{name}",
      "key": " cpu",
      "keyColor": "cyan",
      "type": "cpu"
    },
    {
      "format": "",
      "key": " gpu",
      "keyColor": "magenta",
      "type": "gpu"
    },
    {
      "format": "{used} / {total}",
      "key": " ram",
      "keyColor": "light_blue",
      "type": "memory"
    },
    {
      "key": " color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
}
